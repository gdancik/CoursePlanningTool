{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "entry": [
    "src/index.tsx",
    "src/main.tsx",
    "src/App.tsx",
    "src/setupTests.js",
    "src/setupProxy.js",
    "src/test/**/*.{test,spec}.{js,jsx,ts,tsx}",
    "src/test/mocks/browser.ts"
  ],
  "project": [
    "src/**/*.{js,jsx,ts,tsx}"
  ],
  "ignore": [
    "src/oldApp.tsx",
    "src/TestPages/**"
  ]
}